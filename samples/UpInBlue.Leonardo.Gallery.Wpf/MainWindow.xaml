<Window
    x:Class="UpInBlue.Leonardo.Gallery.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:UpInBlue.Leonardo.Gallery.Wpf.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:UpInBlue.Leonardo.Gallery.Wpf.ViewModels"
    Title="Leonardo WPF Gallery"
    Width="1100"
    Height="900"
    MinWidth="480"
    MinHeight="400"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    mc:Ignorable="d">

    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
        <Border Padding="{StaticResource LeonardoSpaceLVerticalThickness}">
            <StackPanel Margin="{StaticResource LeonardoSpaceXLHorizontalThickness}">

                <!-- Group 1: where am I, and how this window looks and moves. -->
                <Grid x:Name="HeaderGroup">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        VerticalAlignment="Bottom"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource LeonardoPlaceNameTextStyle}"
                        Text="Foundations" />

                    <StackPanel Grid.Column="1" Margin="{StaticResource LeonardoSpaceMLeftThickness}" VerticalAlignment="Bottom">
                        <TextBlock
                            x:Name="ThemeLabel"
                            Margin="{StaticResource LeonardoSpaceXSBottomThickness}"
                            Style="{StaticResource LeonardoBodyTextStyle}"
                            Text="App theme" />
                        <ComboBox
                            Width="{StaticResource GalleryThemeBoxWidth}"
                            AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}"
                            DisplayMemberPath="Label"
                            ItemsSource="{Binding ThemeOptions}"
                            SelectedValue="{Binding Theme}"
                            SelectedValuePath="Value" />
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="{StaticResource LeonardoSpaceMTopThickness}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            MaxWidth="{StaticResource GalleryReadingWidth}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource LeonardoMetaTextStyle}"
                            Text="{Binding MotionStatus}" />
                        <Button
                            Grid.Column="1"
                            Margin="{StaticResource LeonardoSpaceMLeftThickness}"
                            Click="OnReplayEntrance"
                            Content="Replay entrance" />
                    </Grid>
                </Grid>

                <!-- Group 2: color. -->
                <StackPanel x:Name="ColorGroup" Margin="{StaticResource LeonardoSpaceXLTopThickness}">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource LeonardoSectionTextStyle}" Text="Color" />
                    <TextBlock
                        MaxWidth="{StaticResource GalleryReadingWidth}"
                        Margin="{StaticResource LeonardoSpaceSTopThickness}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource LeonardoBodyTextStyle}"
                        Text="Every color means exactly one thing. The surface is cool-neutral; blue comes only from the blue scale, and only where it carries meaning." />
                    <TextBlock
                        MaxWidth="{StaticResource GalleryReadingWidth}"
                        Margin="{StaticResource LeonardoSpaceSTopThickness}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource LeonardoBodyStrongTextStyle}"
                        Text="A contrast theme is on. Apps use the colors of the contrast theme instead of Leonardo colors, so the values below are shown as text only."
                        Visibility="{Binding IsContrastTheme, Converter={StaticResource BooleanToVisibility}}" />

                    <TextBlock
                        Margin="{StaticResource LeonardoSpaceMTopThickness}"
                        AutomationProperties.HeadingLevel="Level3"
                        Style="{StaticResource LeonardoBodyStrongTextStyle}"
                        Text="Theme colors" />
                    <TextBlock Style="{StaticResource LeonardoMetaTextStyle}" Text="The colors of the active theme, read from the Leonardo resources." />
                    <ItemsControl Focusable="False" ItemsSource="{Binding ThemeColors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ThemeColorItem}">
                                <Grid Margin="{StaticResource LeonardoSpaceSVerticalThickness}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="{StaticResource GalleryLabelColumnWidth}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        x:Name="Swatch"
                                        Width="{StaticResource GallerySwatchSize}"
                                        Height="{StaticResource GallerySwatchSize}"
                                        Margin="{StaticResource LeonardoSpaceMRightThickness}"
                                        helpers:ResourceReference.Background="{Binding BrushKey}"
                                        BorderBrush="{DynamicResource LeonardoStrokeSubtleBrush}"
                                        BorderThickness="{StaticResource GalleryHairlineThickness}"
                                        CornerRadius="{StaticResource LeonardoRadiusS}"
                                        Visibility="{Binding DataContext.ShowsSwatches, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource LeonardoBodyStrongTextStyle}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource LeonardoMetaTabularTextStyle}" Text="{Binding Background, ElementName=Swatch, Converter={StaticResource BrushToHex}}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource LeonardoBodyTextStyle}"
                                        Text="{Binding Use}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Margin="{StaticResource LeonardoSpaceMTopThickness}"
                        AutomationProperties.HeadingLevel="Level3"
                        Style="{StaticResource LeonardoBodyStrongTextStyle}"
                        Text="Accent on Fluent controls" />
                    <TextBlock
                        MaxWidth="{StaticResource GalleryReadingWidth}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource LeonardoMetaTextStyle}"
                        Text="Standard WPF controls with the Fluent theme. Leonardo replaces only the accent: brand in light theme, far in dark theme." />
                    <WrapPanel Margin="{StaticResource LeonardoSpaceSTopThickness}">
                        <Button
                            Margin="{StaticResource LeonardoSpaceMRightThickness}"
                            Content="Renew contract"
                            Style="{DynamicResource AccentButtonStyle}" />
                        <CheckBox
                            Margin="{StaticResource LeonardoSpaceMRightThickness}"
                            VerticalAlignment="Center"
                            Content="Remind me before renewal"
                            IsChecked="True" />
                        <TextBlock Margin="{StaticResource LeonardoSpaceMRightThickness}" VerticalAlignment="Center" Style="{StaticResource LeonardoBodyTextStyle}">
                            <Hyperlink Click="OnHyperlinkClick">Open the contract</Hyperlink>
                        </TextBlock>
                    </WrapPanel>
                </StackPanel>

                <!-- Group 3: typography. -->
                <StackPanel x:Name="TypographyGroup" Margin="{StaticResource LeonardoSpaceXLTopThickness}">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource LeonardoSectionTextStyle}" Text="Typography" />
                    <TextBlock
                        MaxWidth="{StaticResource GalleryReadingWidth}"
                        Margin="{StaticResource LeonardoSpaceSTopThickness}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource LeonardoBodyTextStyle}"
                        Text="Type replaces frames. Hierarchy comes from size, weight and white space. Only these roles exist; emphasis is the body role in semibold." />
                    <ItemsControl Focusable="False" ItemsSource="{Binding TypeRoles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TypeRoleItem}">
                                <StackPanel Margin="{StaticResource LeonardoSpaceMTopThickness}">
                                    <TextBlock Style="{StaticResource LeonardoMetaTextStyle}" Text="{Binding Spec}" />
                                    <TextBlock
                                        MaxWidth="{StaticResource GalleryReadingWidth}"
                                        HorizontalAlignment="Left"
                                        helpers:ResourceReference.Style="{Binding StyleKey}"
                                        Text="{Binding Sample}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Group 4: density. -->
                <StackPanel x:Name="DensityGroup" Margin="{StaticResource LeonardoSpaceXLTopThickness}">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource LeonardoSectionTextStyle}" Text="Density" />
                    <TextBlock
                        MaxWidth="{StaticResource GalleryReadingWidth}"
                        Margin="{StaticResource LeonardoSpaceSTopThickness}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource LeonardoBodyTextStyle}"
                        Text="Lists offer three row heights. Standard is the default; your choice is saved for your Windows account." />

                    <TextBlock
                        x:Name="RowHeightLabel"
                        Margin="{StaticResource LeonardoSpaceMTopThickness}"
                        Style="{StaticResource LeonardoBodyTextStyle}"
                        Text="Row height" />
                    <StackPanel
                        Margin="{StaticResource LeonardoSpaceXSTopThickness}"
                        AutomationProperties.LabeledBy="{Binding ElementName=RowHeightLabel}"
                        Orientation="Horizontal">
                        <RadioButton
                            Margin="{StaticResource LeonardoSpaceMRightThickness}"
                            Content="Compact"
                            GroupName="Density"
                            IsChecked="{Binding IsCompact}" />
                        <RadioButton
                            Margin="{StaticResource LeonardoSpaceMRightThickness}"
                            Content="Standard"
                            GroupName="Density"
                            IsChecked="{Binding IsStandard}" />
                        <RadioButton Content="Comfortable" GroupName="Density" IsChecked="{Binding IsComfortable}" />
                    </StackPanel>

                    <Border Margin="{StaticResource LeonardoSpaceMTopThickness}">
                    <ListView
                        x:Name="ContractsList"
                        Margin="{StaticResource GalleryTableOutdentThickness}"
                        AutomationProperties.Name="Contracts"
                        ItemsSource="{Binding Contracts}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                                <Setter Property="Height" Value="{DynamicResource GalleryRowHeight}" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Contract}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Width="{StaticResource GalleryNameColumnWidth}" Header="Customer">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ContractRow}">
                                            <TextBlock Style="{StaticResource LeonardoBodyTextStyle}" Text="{Binding Customer}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="{StaticResource GalleryNameColumnWidth}" Header="Contract">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ContractRow}">
                                            <TextBlock Style="{StaticResource LeonardoBodyTextStyle}" Text="{Binding Contract}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="{StaticResource GalleryPersonColumnWidth}" Header="Owner">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ContractRow}">
                                            <TextBlock Style="{StaticResource LeonardoBodyTextStyle}" Text="{Binding Owner}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="{StaticResource GalleryNumberColumnWidth}">
                                    <GridViewColumn.Header>
                                        <TextBlock Text="Annual value (EUR)" TextAlignment="Right" />
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ContractRow}">
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource LeonardoBodyTabularTextStyle}" Text="{Binding AnnualValue}" TextWrapping="NoWrap" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="{StaticResource GalleryDateColumnWidth}" Header="Renewal">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ContractRow}">
                                            <TextBlock Style="{StaticResource LeonardoBodyTabularTextStyle}" Text="{Binding Renewal}" TextWrapping="NoWrap" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
