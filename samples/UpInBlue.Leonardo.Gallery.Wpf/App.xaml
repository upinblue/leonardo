<Application
    x:Class="UpInBlue.Leonardo.Gallery.Wpf.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ShutdownMode="OnMainWindowClose">
    <!--
        The Fluent theme and Leonardo are applied in OnStartup with LeonardoTheme.Apply, which sets ThemeMode and merges
        the Leonardo dictionary for the active theme.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Gallery.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
