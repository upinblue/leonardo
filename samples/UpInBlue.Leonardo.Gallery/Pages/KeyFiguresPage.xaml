<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UpInBlue.Leonardo.Gallery.Pages.KeyFiguresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:UpInBlue.Leonardo.Gallery.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource LeonardoSpaceLVerticalThickness}" Spacing="{StaticResource LeonardoSpaceXL}">
            <StackPanel Margin="{StaticResource LeonardoSpaceLHorizontalThickness}">
                <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{ThemeResource LeonardoPlaceNameTextStyle}" Text="Key figures" />
                <TextBlock Style="{ThemeResource LeonardoBodyTextStyle}" Text="November 2026" />
            </StackPanel>

            <StackPanel Margin="{StaticResource LeonardoSpaceLHorizontalThickness}" Spacing="{StaticResource LeonardoSpaceXL}">
                <!-- Numbers carry the hierarchy; no cards, no frames. -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Figures}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="{StaticResource LeonardoSpaceXL}"
                            MinItemWidth="{StaticResource GalleryFigureWidth}"
                            MinRowSpacing="{StaticResource LeonardoSpaceL}" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:KeyFigure">
                            <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}">
                                <TextBlock Style="{ThemeResource LeonardoBodyStrongTextStyle}" Text="{x:Bind Label}" />
                                <TextBlock Style="{ThemeResource LeonardoViewTextStyle}" Text="{x:Bind Value}" />
                                <TextBlock Style="{ThemeResource LeonardoMetaTextStyle}" Text="{x:Bind Context}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <StackPanel Spacing="{StaticResource LeonardoSpaceS}">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource LeonardoSectionTextStyle}" Text="Files shared per month" />
                    <ItemsControl AutomationProperties.Name="{x:Bind ViewModel.ChartSummary}" ItemsSource="{x:Bind ViewModel.Bars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource LeonardoSpaceM}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChartBar">
                                <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}" Spacing="{StaticResource LeonardoSpaceXS}">
                                    <!-- Values on one line above the bars, read like a table row. -->
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{ThemeResource LeonardoMetaTabularTextStyle}"
                                        Text="{x:Bind ValueText}" />
                                    <Grid Height="{StaticResource GalleryChartHeight}">
                                        <Border
                                            Width="{StaticResource GalleryChartBarWidth}"
                                            Height="{x:Bind Height}"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource LeonardoChartBrush}"
                                            CornerRadius="{StaticResource LeonardoRadiusS}" />
                                    </Grid>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{ThemeResource LeonardoMetaTextStyle}"
                                        Text="{x:Bind Month}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        MaxWidth="{StaticResource GalleryReadingWidth}"
                        HorizontalAlignment="Left"
                        Style="{ThemeResource LeonardoMetaTextStyle}"
                        Text="{x:Bind ViewModel.ChartSummary}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
