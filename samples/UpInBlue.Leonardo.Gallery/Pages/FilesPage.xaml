<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UpInBlue.Leonardo.Gallery.Pages.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="using:UpInBlue.Leonardo.Gallery"
    xmlns:helpers="using:UpInBlue.Leonardo.Gallery.Helpers"
    xmlns:leonardo="using:UpInBlue.Leonardo.WinUI.Controls"
    xmlns:models="using:UpInBlue.Leonardo.Gallery.Models"
    xmlns:vm="using:UpInBlue.Leonardo.Gallery.ViewModels">

    <!-- Asymmetric balance: folder tree fixed, file list flexible, details fixed. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TreeColumn" Width="{StaticResource GalleryTreePaneWidth}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailsColumn" Width="{StaticResource GalleryDetailsPaneWidth}" />
        </Grid.ColumnDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource GalleryDetailsPaneWindowWidth}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource GalleryTreePaneWindowWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailsColumn.Width" Value="0" />
                        <Setter Target="DetailsPane.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailsColumn.Width" Value="0" />
                        <Setter Target="DetailsPane.Visibility" Value="Collapsed" />
                        <Setter Target="TreeColumn.Width" Value="0" />
                        <Setter Target="FolderTree.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Folder tree -->
        <TreeView
            x:Name="FolderTree"
            Padding="{StaticResource LeonardoSpaceLTopThickness}"
            AutomationProperties.Name="Folders"
            ItemInvoked="OnFolderInvoked"
            ItemsSource="{x:Bind ViewModel.Folders}"
            SelectionMode="Single">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="models:FolderNode">
                    <TreeViewItem
                        AutomationProperties.Name="{x:Bind Name}"
                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                        ItemsSource="{x:Bind Children}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource LeonardoSpaceXS}">
                            <FontIcon FontSize="{StaticResource LeonardoSizeIcon}" Glyph="&#xE8B7;" />
                            <TextBlock Style="{ThemeResource LeonardoBodyTextStyle}" Text="{x:Bind Name}" />
                        </StackPanel>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- File list -->
        <Grid Grid.Column="1" Padding="{StaticResource LeonardoSpaceLTopThickness}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Commands of the view, always visible at the top. -->
            <CommandBar
                Margin="{StaticResource LeonardoSpaceSRightThickness}"
                HorizontalAlignment="Right"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <AppBarButton Command="{x:Bind ViewModel.SampleOnlyCommand}" CommandParameter="Upload" Label="Upload">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE898;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Command="{x:Bind ViewModel.SampleOnlyCommand}" CommandParameter="Sharing" Label="Share">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72D;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="OnDeleteClicked" Label="Delete">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Command="{x:Bind ViewModel.SampleOnlyCommand}" CommandParameter="New folder" Label="New folder">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8F4;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <!-- Where am I: the path above the place name. -->
            <BreadcrumbBar
                x:Name="Breadcrumb"
                Grid.Row="1"
                Margin="{StaticResource LeonardoSpaceXLHorizontalThickness}"
                AutomationProperties.Name="Folder path"
                ItemClicked="OnBreadcrumbClicked"
                ItemsSource="{x:Bind ViewModel.Folder.Trail}" />

            <!-- Where am I, and what happened since the last visit. Shrinks to a compact line when the list scrolls. -->
            <leonardo:PlaceHeader
                x:Name="PlaceHeader"
                Grid.Row="2"
                Margin="{StaticResource LeonardoSpaceXLHorizontalThickness}"
                ScrollSource="{x:Bind FileList}"
                Title="{x:Bind ViewModel.Folder.Name}">
                <leonardo:SummaryLine
                    Margin="{StaticResource LeonardoSpaceSTopThickness}"
                    Items="{x:Bind ViewModel.Summary}"
                    Prefix="Since your last visit:" />
            </leonardo:PlaceHeader>

            <!-- What just happened: shown where it happened, with undo. -->
            <StackPanel
                Grid.Row="3"
                Margin="{StaticResource LeonardoSpaceXLHorizontalThickness}"
                Padding="{StaticResource LeonardoSpaceSTopThickness}"
                Orientation="Horizontal"
                Spacing="{StaticResource LeonardoSpaceS}"
                Visibility="{x:Bind helpers:Show.WhenText(ViewModel.Feedback), Mode=OneWay}">
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{ThemeResource LeonardoBodyTextStyle}"
                    Text="{x:Bind ViewModel.Feedback, Mode=OneWay}" />
                <HyperlinkButton
                    Click="OnUndoClicked"
                    Content="Undo"
                    Visibility="{x:Bind helpers:Show.When(ViewModel.CanUndo), Mode=OneWay}" />
            </StackPanel>

            <ListView
                x:Name="FileList"
                Grid.Row="4"
                Margin="{StaticResource LeonardoSpaceXLTopThickness}"
                Padding="{StaticResource LeonardoSpaceXSLeftThickness}"
                AutomationProperties.Name="Files"
                ItemContainerStyle="{StaticResource GalleryStatusTableItemStyle}"
                DoubleTapped="OnFileListDoubleTapped"
                ItemsSource="{x:Bind ViewModel.Entries}"
                PreviewKeyDown="OnFileListPreviewKeyDown"
                SelectionChanged="OnFileSelectionChanged"
                SizeChanged="OnFileListSizeChanged"
                SelectionMode="Single">
                <!-- Leave and Reflow animate deletions; the platform's own item transitions would animate them a second time. -->
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.Header>
                    <!-- Same padding as the rows; the icon and status columns hang left of "Name". -->
                    <Grid
                        Padding="{StaticResource LeonardoSpaceXSHorizontalThickness}"
                        AutomationProperties.AccessibilityView="Raw"
                        ColumnSpacing="{StaticResource LeonardoSpaceM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{x:Bind vm:TableColumns.Files.DateWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:TableColumns.Files.PersonWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{StaticResource GalleryNumberColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="{StaticResource LeonardoSizeIcon}" />
                            <Border Width="{StaticResource LeonardoSizeStatusDot}" />
                            <TextBlock
                                Margin="{StaticResource LeonardoSpaceXSLeftThickness}"
                                Style="{ThemeResource LeonardoMetaTextStyle}"
                                Text="Name" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Visibility="{x:Bind vm:TableColumns.Files.DateVisibility, Mode=OneWay}" Style="{ThemeResource LeonardoMetaTextStyle}" Text="Modified" />
                        <TextBlock Grid.Column="2" Visibility="{x:Bind vm:TableColumns.Files.PersonVisibility, Mode=OneWay}" Style="{ThemeResource LeonardoMetaTextStyle}" Text="Modified by" />
                        <TextBlock
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Style="{ThemeResource LeonardoMetaTextStyle}"
                            Text="Size" />
                    </Grid>
                </ListView.Header>
                <ListView.Footer>
                    <!-- Empty folder: explain what appears here and offer the first action. -->
                    <StackPanel
                        Padding="{StaticResource LeonardoSpaceMHorizontalThickness}"
                        Orientation="Horizontal"
                        Spacing="{StaticResource LeonardoSpaceXS}"
                        Visibility="{x:Bind helpers:Show.When(ViewModel.IsFolderEmpty), Mode=OneWay}">
                        <Border Width="{StaticResource LeonardoSizeIcon}" />
                        <StackPanel Padding="{StaticResource LeonardoSpaceLVerticalThickness}" Spacing="{StaticResource LeonardoSpaceS}">
                            <TextBlock Style="{ThemeResource LeonardoSectionTextStyle}" Text="This folder is empty" />
                            <TextBlock Style="{ThemeResource LeonardoBodyTextStyle}" Text="Files you upload to this folder appear here." />
                            <Button
                                Command="{x:Bind ViewModel.SampleOnlyCommand}"
                                CommandParameter="Upload"
                                Content="Upload files"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ListView.Footer>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:FileItem">
                        <Grid
                            MinHeight="{x:Bind gallery:App.Settings.RowHeight, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind AccessibleName}"
                            ColumnSpacing="{StaticResource LeonardoSpaceM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{x:Bind vm:TableColumns.Files.DateWidth, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind vm:TableColumns.Files.PersonWidth, Mode=OneWay}" />
                                <ColumnDefinition Width="{StaticResource GalleryNumberColumnWidth}" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="OnOpenClicked"
                                        Text="Open"
                                        Visibility="{x:Bind helpers:Show.When(IsFolder)}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8DA;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="OnShareClicked" Text="Share">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE72D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Click="OnDeleteClicked"
                                        Text="Delete"
                                        Visibility="{x:Bind helpers:Show.Unless(IsFolder)}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <!-- Icon and status dot hang left of the alignment line: 4 + 4 + 16 + 12 + 4 = 40.
                                 The dot sits next to the name, away from the selection indicator at the left edge. -->
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Column="1"
                                    Width="{StaticResource LeonardoSizeStatusDot}"
                                    Margin="{StaticResource LeonardoSpaceXSTopThickness}"
                                    VerticalAlignment="Top">
                                    <leonardo:StatusDot
                                        Description="{x:Bind StatusDescription}"
                                        Kind="{x:Bind StatusValue}"
                                        Visibility="{x:Bind helpers:Show.When(HasStatus)}" />
                                </Grid>
                                <FontIcon
                                    VerticalAlignment="Top"
                                    FontSize="{StaticResource LeonardoSizeIcon}"
                                    Glyph="{x:Bind Glyph}" />
                                <TextBlock
                                    x:Name="EntryName"
                                    Grid.Column="2"
                                    Margin="{StaticResource LeonardoSpaceXSLeftThickness}"
                                    Style="{ThemeResource LeonardoBodyTextStyle}"
                                    Text="{x:Bind Name}" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                Visibility="{x:Bind vm:TableColumns.Files.DateVisibility, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Style="{ThemeResource LeonardoBodyTabularTextStyle}"
                                Text="{x:Bind ModifiedText}" />
                            <TextBlock
                                Grid.Column="2"
                                Visibility="{x:Bind vm:TableColumns.Files.PersonVisibility, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Style="{ThemeResource LeonardoBodyTextStyle}"
                                Text="{x:Bind ModifiedBy}" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{ThemeResource LeonardoBodyTabularTextStyle}"
                                Text="{x:Bind SizeText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Grid>

        <!-- Details of the selected file -->
        <ScrollViewer
            x:Name="DetailsPane"
            Grid.Column="2"
            AutomationProperties.Name="Details"
            Background="{ThemeResource LeonardoSurfaceAltBrush}">
            <StackPanel Padding="{StaticResource LeonardoSpaceLThickness}" Spacing="{StaticResource LeonardoSpaceM}">
                <TextBlock
                    Style="{ThemeResource LeonardoBodyTextStyle}"
                    Text="Select a file or folder to see its details."
                    Visibility="{x:Bind helpers:Show.Unless(ViewModel.HasSelection), Mode=OneWay}" />

                <StackPanel Spacing="{StaticResource LeonardoSpaceM}" Visibility="{x:Bind helpers:Show.When(ViewModel.HasSelection), Mode=OneWay}">
                    <FontIcon
                        HorizontalAlignment="Left"
                        FontSize="{StaticResource GalleryLargeIconSize}"
                        Glyph="{x:Bind ViewModel.SelectedEntry.Glyph, Mode=OneWay, FallbackValue=''}" />
                    <StackPanel>
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{ThemeResource LeonardoSectionTextStyle}"
                            Text="{x:Bind ViewModel.SelectedEntry.Name, Mode=OneWay, FallbackValue=''}" />
                        <TextBlock Style="{ThemeResource LeonardoMetaTextStyle}" Text="{x:Bind ViewModel.SelectedEntry.Kind, Mode=OneWay, FallbackValue=''}" />
                    </StackPanel>
                    <StackPanel Visibility="{x:Bind helpers:Show.When(ViewModel.SelectedHasStatus), Mode=OneWay}">
                        <TextBlock Style="{ThemeResource LeonardoMetaTextStyle}" Text="Status" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource LeonardoSpaceXS}">
                            <leonardo:StatusDot
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Description="{x:Bind ViewModel.SelectedEntry.StatusDescription, Mode=OneWay, FallbackValue=''}"
                                Kind="{x:Bind ViewModel.SelectedEntry.StatusValue, Mode=OneWay}" />
                            <TextBlock Style="{ThemeResource LeonardoBodyTextStyle}" Text="{x:Bind ViewModel.SelectedEntry.StatusDescription, Mode=OneWay, FallbackValue=''}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{ThemeResource LeonardoMetaTextStyle}" Text="Modified" />
                        <TextBlock Style="{ThemeResource LeonardoBodyTextStyle}" Text="{x:Bind ViewModel.SelectedEntry.ModifiedLongText, Mode=OneWay, FallbackValue=''}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{ThemeResource LeonardoMetaTextStyle}" Text="Modified by" />
                        <TextBlock Style="{ThemeResource LeonardoBodyTextStyle}" Text="{x:Bind ViewModel.SelectedEntry.ModifiedBy, Mode=OneWay, FallbackValue=''}" />
                    </StackPanel>
                    <Button
                        Click="OnOpenClicked"
                        Content="Open folder"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind helpers:Show.When(ViewModel.IsFolderSelected), Mode=OneWay}" />
                    <StackPanel Visibility="{x:Bind helpers:Show.When(ViewModel.IsFileSelected), Mode=OneWay}">
                        <TextBlock Style="{ThemeResource LeonardoMetaTextStyle}" Text="Size" />
                        <TextBlock Style="{ThemeResource LeonardoBodyTextStyle}" Text="{x:Bind ViewModel.SelectedEntry.SizeText, Mode=OneWay, FallbackValue=''}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{ThemeResource LeonardoMetaTextStyle}" Text="Location" />
                        <TextBlock Style="{ThemeResource LeonardoBodyTextStyle}" Text="{x:Bind ViewModel.SelectedEntry.Location, Mode=OneWay, FallbackValue=''}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
