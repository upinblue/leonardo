<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UpInBlue.Leonardo.Gallery.Pages.ApprovalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gallery="using:UpInBlue.Leonardo.Gallery"
    xmlns:helpers="using:UpInBlue.Leonardo.Gallery.Helpers"
    xmlns:leonardo="using:UpInBlue.Leonardo.WinUI.Controls"
    xmlns:vm="using:UpInBlue.Leonardo.Gallery.ViewModels">

    <!-- Inbox: the list of requests is flexible, the details of the selected request are fixed. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailsColumn" Width="{StaticResource GalleryDetailsPaneWidth}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource GalleryTreePaneWindowWidth}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailsColumn.Width" Value="{StaticResource GalleryTreePaneWidth}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Where am I, and what is waiting. Shrinks to a compact line when the list scrolls. -->
        <leonardo:PlaceHeader
            x:Name="PlaceHeader"
            Margin="{StaticResource LeonardoSpaceXLHorizontalThickness}"
            Padding="{StaticResource LeonardoSpaceLVerticalThickness}"
            ScrollSource="{x:Bind RequestList}"
            Title="Approvals">
            <StackPanel Margin="{StaticResource LeonardoSpaceSTopThickness}">
                <leonardo:SummaryLine Items="{x:Bind ViewModel.Summary}" Prefix="In your inbox:" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Style="{ThemeResource LeonardoBodyTextStyle}"
                    Text="Nothing is waiting for you."
                    Visibility="{x:Bind helpers:Show.When(ViewModel.IsInboxEmpty), Mode=OneWay}" />
            </StackPanel>
        </leonardo:PlaceHeader>

        <ListView
            x:Name="RequestList"
            Grid.Row="1"
            Padding="{StaticResource LeonardoSpaceXSLeftThickness}"
            AutomationProperties.Name="Requests"
            ItemContainerStyle="{StaticResource GalleryStatusTableItemStyle}"
            ItemsSource="{x:Bind ViewModel.Shown}"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
            SelectionChanged="OnRequestSelectionChanged"
            SelectionMode="Single">
            <!-- Reflow animates filtering; the platform's own item transitions would animate it a second time. -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ApprovalRequest">
                    <Grid
                        MinHeight="{x:Bind gallery:App.Settings.RowHeight, Mode=OneWay}"
                        Padding="{StaticResource LeonardoSpaceXSVerticalThickness}"
                        AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                        <!-- Icon and status dot hang left of the alignment line: 4 + 4 + 16 + 12 + 4 = 40.
                             The dot sits next to the title, away from the selection indicator at the left edge. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Grid.Column="1"
                            Width="{StaticResource LeonardoSizeStatusDot}"
                            Margin="{StaticResource LeonardoSpaceXSTopThickness}"
                            VerticalAlignment="Top">
                            <leonardo:StatusDot
                                Margin="{StaticResource LeonardoSpaceXSTopThickness}"
                                Description="New since your last visit"
                                Kind="New"
                                Visibility="{x:Bind helpers:Show.When(ShowsNew), Mode=OneWay}" />
                        </Grid>
                        <FontIcon
                            Grid.Column="0"
                            Margin="{StaticResource LeonardoSpaceXSTopThickness}"
                            VerticalAlignment="Top"
                            FontSize="{StaticResource LeonardoSizeIcon}"
                            Glyph="{x:Bind StateGlyph, Mode=OneWay}" />
                        <StackPanel
                            Grid.Column="2"
                            Margin="{StaticResource LeonardoSpaceXSLeftThickness}"
                            VerticalAlignment="Center">
                            <TextBlock Style="{ThemeResource LeonardoBodyTextStyle}" Text="{x:Bind Title}" />
                            <TextBlock Style="{ThemeResource LeonardoMetaTextStyle}">
                                <Run Text="{x:Bind StateText, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{x:Bind Meta}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock
                            Grid.Column="3"
                            Margin="{StaticResource LeonardoSpaceMLeftThickness}"
                            VerticalAlignment="Center"
                            Style="{ThemeResource LeonardoBodyTabularTextStyle}"
                            Text="{x:Bind AmountText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Details and decision -->
        <ScrollViewer
            Grid.RowSpan="2"
            Grid.Column="1"
            AutomationProperties.Name="Request details"
            Background="{ThemeResource LeonardoSurfaceAltBrush}">
            <StackPanel Padding="{StaticResource LeonardoSpaceLThickness}" Spacing="{StaticResource LeonardoSpaceM}">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{ThemeResource LeonardoSectionTextStyle}"
                    Text="{x:Bind ViewModel.Selected.Title, Mode=OneWay}" />
                <StackPanel>
                    <TextBlock Style="{ThemeResource LeonardoMetaTextStyle}" Text="Requested by" />
                    <TextBlock Style="{ThemeResource LeonardoBodyTextStyle}" Text="{x:Bind ViewModel.Selected.Requester, Mode=OneWay}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{ThemeResource LeonardoMetaTextStyle}" Text="Customer" />
                    <TextBlock Style="{ThemeResource LeonardoBodyTextStyle}" Text="{x:Bind ViewModel.Selected.Company, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Visibility="{x:Bind helpers:Show.WhenText(ViewModel.Selected.AmountText), Mode=OneWay}">
                    <TextBlock Style="{ThemeResource LeonardoMetaTextStyle}" Text="Amount" />
                    <TextBlock Style="{ThemeResource LeonardoBodyTabularTextStyle}" Text="{x:Bind ViewModel.Selected.AmountText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{ThemeResource LeonardoMetaTextStyle}" Text="Reason" />
                    <TextBlock Style="{ThemeResource LeonardoBodyTextStyle}" Text="{x:Bind ViewModel.Selected.Description, Mode=OneWay}" />
                </StackPanel>

                <!-- Waiting: decide. -->
                <StackPanel
                    x:Name="WaitingPanel"
                    Spacing="{StaticResource LeonardoSpaceM}"
                    Visibility="{x:Bind helpers:Show.When(ViewModel.Selected.IsWaiting), Mode=OneWay}">
                    <TextBox
                        AcceptsReturn="True"
                        Header="Comment for the requester (optional)"
                        Text="{x:Bind ViewModel.Selected.Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource LeonardoSpaceS}">
                        <Button
                            x:Name="ApproveButton"
                            Click="OnApproveClicked"
                            Content="Approve"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="RejectButton"
                            Click="OnRejectClicked"
                            Content="Reject" />
                    </StackPanel>
                </StackPanel>

                <!-- Decided: what just happened, with undo. The pressed button transforms into this panel. -->
                <StackPanel
                    x:Name="DecisionPanel"
                    Spacing="{StaticResource LeonardoSpaceS}"
                    Visibility="{x:Bind helpers:Show.Unless(ViewModel.Selected.IsWaiting), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource LeonardoSpaceXS}">
                        <FontIcon FontSize="{StaticResource LeonardoSizeIcon}" Glyph="{x:Bind ViewModel.Selected.StateGlyph, Mode=OneWay}" />
                        <TextBlock Style="{ThemeResource LeonardoBodyStrongTextStyle}" Text="{x:Bind ViewModel.Selected.StateText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{ThemeResource LeonardoBodyTextStyle}"
                        Text="{x:Bind ViewModel.Selected.DecisionText, Mode=OneWay}" />
                    <Button
                        x:Name="UndoDecisionButton"
                        Click="OnUndoClicked"
                        Content="Undo decision" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
