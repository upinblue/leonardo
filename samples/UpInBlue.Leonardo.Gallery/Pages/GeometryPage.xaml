<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UpInBlue.Leonardo.Gallery.Pages.GeometryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:UpInBlue.Leonardo.Gallery.ViewModels">

    <Page.Resources>
        <!-- A value with a bar of its size and its use. -->
        <DataTemplate x:Key="ValueTemplate" x:DataType="vm:GeometrySample">
            <Grid
                Padding="{StaticResource LeonardoSpaceXSVerticalThickness}"
                AutomationProperties.Name="{x:Bind AccessibleName}"
                ColumnSpacing="{StaticResource LeonardoSpaceM}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource GalleryLabelColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource GalleryNumberColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource GalleryNumberColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{ThemeResource LeonardoBodyStrongTextStyle}" Text="{x:Bind Name}" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Style="{ThemeResource LeonardoBodyTabularTextStyle}"
                    Text="{x:Bind ValueText}" />
                <Border
                    Grid.Column="2"
                    Width="{x:Bind Value}"
                    Height="{StaticResource LeonardoSpaceM}"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource LeonardoStrokeStrongBrush}" />
                <TextBlock Grid.Column="3" Style="{ThemeResource LeonardoBodyTextStyle}" Text="{x:Bind Use}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="{StaticResource LeonardoSpaceLVerticalThickness}" Spacing="{StaticResource LeonardoSpaceXL}">
            <TextBlock
                Margin="{StaticResource LeonardoSpaceLHorizontalThickness}"
                AutomationProperties.HeadingLevel="Level1"
                Style="{ThemeResource LeonardoPlaceNameTextStyle}"
                Text="Grid and geometry" />

            <StackPanel Margin="{StaticResource LeonardoSpaceLHorizontalThickness}" Spacing="{StaticResource LeonardoSpaceL}">
                <TextBlock
                    MaxWidth="{StaticResource GalleryReadingWidth}"
                    HorizontalAlignment="Left"
                    Style="{ThemeResource LeonardoBodyTextStyle}"
                    Text="Everything sits on a base grid of 4; layout spacing jumps in steps of 8. On Windows the values are effective pixels and match the Fluent grid." />

                <StackPanel Spacing="{StaticResource LeonardoSpaceS}">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource LeonardoSectionTextStyle}" Text="Spacing" />
                    <ItemsControl ItemTemplate="{StaticResource ValueTemplate}" ItemsSource="{x:Bind ViewModel.Spacing}" />
                </StackPanel>

                <StackPanel Spacing="{StaticResource LeonardoSpaceS}">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource LeonardoSectionTextStyle}" Text="Sizes" />
                    <ItemsControl ItemTemplate="{StaticResource ValueTemplate}" ItemsSource="{x:Bind ViewModel.Sizes}" />
                </StackPanel>

                <StackPanel Spacing="{StaticResource LeonardoSpaceS}">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource LeonardoSectionTextStyle}" Text="Alignment line" />
                    <TextBlock
                        MaxWidth="{StaticResource GalleryReadingWidth}"
                        HorizontalAlignment="Left"
                        Style="{ThemeResource LeonardoMetaTextStyle}"
                        Text="The page margin is space.l, the distance from the content edge to the content. The alignment line is the left edge on which text starts: on pages with icon lists it lies at space.xl, and place name, headings, column headers and list text start on it while icons and status dots hang to the left of it. Other pages, like this one, use the page margin as their alignment line." />
                    <Grid
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Example: a title, a column header and two files share one left edge; the file icons hang to the left of it."
                        RowSpacing="{StaticResource LeonardoSpaceS}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Rectangle
                            Grid.RowSpan="4"
                            Grid.Column="1"
                            Width="{StaticResource GalleryGuideLineWidth}"
                            HorizontalAlignment="Left"
                            Fill="{ThemeResource LeonardoStrokeStrongBrush}" />
                        <TextBlock Grid.Column="1" Style="{ThemeResource LeonardoViewTextStyle}" Text="Contracts" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{ThemeResource LeonardoMetaTextStyle}" Text="Name" />
                        <FontIcon
                            Grid.Row="2"
                            Margin="{StaticResource LeonardoSpaceXSRightThickness}"
                            FontSize="{StaticResource LeonardoSizeIcon}"
                            Glyph="&#xE8A5;" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{ThemeResource LeonardoBodyTextStyle}" Text="Framework agreement 2026.docx" />
                        <FontIcon
                            Grid.Row="3"
                            Margin="{StaticResource LeonardoSpaceXSRightThickness}"
                            FontSize="{StaticResource LeonardoSizeIcon}"
                            Glyph="&#xE8B7;" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{ThemeResource LeonardoBodyTextStyle}" Text="Invoices" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="{StaticResource LeonardoSpaceS}">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource LeonardoSectionTextStyle}" Text="Corner radii" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Radii}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource LeonardoSpaceL}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GeometrySample">
                                <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}" Spacing="{StaticResource LeonardoSpaceXS}">
                                    <Border
                                        Width="{StaticResource GallerySampleSize}"
                                        Height="{StaticResource GallerySampleSize}"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource LeonardoSurfaceAltBrush}"
                                        BorderBrush="{ThemeResource LeonardoStrokeStrongBrush}"
                                        BorderThickness="{StaticResource GalleryHairlineThickness}"
                                        CornerRadius="{x:Bind Radius}" />
                                    <TextBlock Style="{ThemeResource LeonardoBodyStrongTextStyle}" Text="{x:Bind Name}" />
                                    <TextBlock Style="{ThemeResource LeonardoMetaTabularTextStyle}" Text="{x:Bind ValueText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="{StaticResource LeonardoSpaceS}">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource LeonardoSectionTextStyle}" Text="Concentric radii" />
                    <TextBlock
                        MaxWidth="{StaticResource GalleryReadingWidth}"
                        HorizontalAlignment="Left"
                        Style="{ThemeResource LeonardoMetaTextStyle}"
                        Text="{x:Bind ViewModel.ConcentricRule}" />
                    <Border
                        Width="{StaticResource GalleryWrapSampleWidth}"
                        Padding="{StaticResource LeonardoSpaceSThickness}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Example: a card with radius l and padding s contains an element with radius m."
                        Background="{ThemeResource LeonardoSurfaceAltBrush}"
                        BorderBrush="{ThemeResource LeonardoStrokeStrongBrush}"
                        BorderThickness="{StaticResource GalleryHairlineThickness}"
                        CornerRadius="{StaticResource LeonardoRadiusL}">
                        <Border
                            Height="{StaticResource GallerySampleSize}"
                            Padding="{StaticResource LeonardoSpaceSThickness}"
                            Background="{ThemeResource LeonardoSurfaceBrush}"
                            BorderBrush="{ThemeResource LeonardoStrokeStrongBrush}"
                            BorderThickness="{StaticResource GalleryHairlineThickness}"
                            CornerRadius="{StaticResource LeonardoRadiusM}">
                            <TextBlock Style="{ThemeResource LeonardoMetaTextStyle}" Text="radius.m inside radius.l" />
                        </Border>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="{StaticResource LeonardoSpaceS}">
                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource LeonardoSectionTextStyle}" Text="List density" />
                    <TextBlock
                        MaxWidth="{StaticResource GalleryReadingWidth}"
                        HorizontalAlignment="Left"
                        Style="{ThemeResource LeonardoMetaTextStyle}"
                        Text="Lists offer three row heights. Standard is the default; choose yours in Settings." />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Densities}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource LeonardoSpaceS}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GeometrySample">
                                <Border
                                    Width="{StaticResource GalleryWrapSampleWidth}"
                                    Height="{x:Bind Value}"
                                    Padding="{StaticResource LeonardoSpaceSHorizontalThickness}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="{x:Bind AccessibleName}"
                                    BorderBrush="{ThemeResource LeonardoStrokeStrongBrush}"
                                    BorderThickness="{StaticResource GalleryHairlineThickness}"
                                    CornerRadius="{StaticResource LeonardoRadiusS}">
                                    <TextBlock VerticalAlignment="Center" Style="{ThemeResource LeonardoBodyTextStyle}">
                                        <Run Text="{x:Bind Use}" />
                                        <Run Foreground="{ThemeResource LeonardoTextTertiaryBrush}" Text="{x:Bind ValueText}" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
