<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UpInBlue.Leonardo.Gallery.Pages.StatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:UpInBlue.Leonardo.Gallery.Helpers">

    <Grid Padding="{StaticResource LeonardoSpaceLVerticalThickness}" RowSpacing="{StaticResource LeonardoSpaceXL}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="{StaticResource LeonardoSpaceXLHorizontalThickness}">
            <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource LeonardoPlaceNameTextStyle}" Text="States" />
            <TextBlock
                MaxWidth="{StaticResource GalleryReadingWidth}"
                HorizontalAlignment="Left"
                Style="{StaticResource LeonardoBodyTextStyle}"
                Text="A view is designed for every state, not only the happy path. Choose a state to see the file list of Kessler Construction in it." />
        </StackPanel>

        <SelectorBar
            x:Name="StateSelector"
            Grid.Row="1"
            Margin="{StaticResource LeonardoSpaceMHorizontalThickness}"
            AutomationProperties.Name="State"
            SelectionChanged="OnStateChanged">
            <SelectorBarItem IsSelected="True" Tag="Empty" Text="Empty" />
            <SelectorBarItem Tag="Loading" Text="Loading" />
            <SelectorBarItem Tag="Error" Text="Error" />
            <SelectorBarItem Tag="Offline" Text="Offline" />
        </SelectorBar>

        <StackPanel Grid.Row="2" Spacing="{StaticResource LeonardoSpaceS}">
            <!-- The structure stays visible in every state: the column headers of the file list. -->
            <Grid
                Margin="{StaticResource LeonardoSpaceXLHorizontalThickness}"
                AutomationProperties.AccessibilityView="Raw"
                ColumnSpacing="{StaticResource LeonardoSpaceM}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource GalleryDateColumnWidth}" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource LeonardoMetaTextStyle}" Text="Name" />
                <TextBlock Grid.Column="1" Style="{StaticResource LeonardoMetaTextStyle}" Text="Modified" />
            </Grid>

            <!-- Empty: explain what appears here and offer the first action. -->
            <StackPanel
                Margin="{StaticResource LeonardoSpaceXLHorizontalThickness}"
                Padding="{StaticResource LeonardoSpaceLVerticalThickness}"
                Spacing="{StaticResource LeonardoSpaceS}"
                Visibility="{x:Bind helpers:Show.When(IsEmpty), Mode=OneWay}">
                <TextBlock Style="{StaticResource LeonardoSectionTextStyle}" Text="No files yet" />
                <TextBlock
                    MaxWidth="{StaticResource GalleryReadingWidth}"
                    HorizontalAlignment="Left"
                    Style="{StaticResource LeonardoBodyTextStyle}"
                    Text="Files you add for Kessler Construction appear here, with the newest first." />
                <Button Click="OnSampleActionClicked" Content="Upload files" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <!-- Loading: one progress bar at the top of the list; nothing else is blocked. -->
            <StackPanel Spacing="{StaticResource LeonardoSpaceS}" Visibility="{x:Bind helpers:Show.When(IsLoading), Mode=OneWay}">
                <ProgressBar
                    Margin="{StaticResource LeonardoSpaceXLHorizontalThickness}"
                    AutomationProperties.Name="Loading files"
                    IsIndeterminate="{x:Bind IsLoading, Mode=OneWay}" />
                <TextBlock
                    Margin="{StaticResource LeonardoSpaceXLHorizontalThickness}"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource LeonardoMetaTextStyle}"
                    Text="Loading files…" />
            </StackPanel>

            <!-- Error: what happened, why, and what to do. -->
            <InfoBar
                Title="Couldn't load the files"
                Margin="{StaticResource LeonardoSpaceXLHorizontalThickness}"
                IsClosable="False"
                IsOpen="{x:Bind IsError, Mode=OneWay}"
                Message="The server didn't respond. Your files are safe. Check your connection, then try again."
                Severity="Error"
                Visibility="{x:Bind helpers:Show.When(IsError), Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Click="OnTryAgainClicked" Content="Try again" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Offline: explain the situation and what still works. -->
            <StackPanel Spacing="{StaticResource LeonardoSpaceS}" Visibility="{x:Bind helpers:Show.When(IsOffline), Mode=OneWay}">
                <InfoBar
                    Title="You're offline"
                    Margin="{StaticResource LeonardoSpaceXLHorizontalThickness}"
                    IsClosable="False"
                    IsOpen="{x:Bind IsOffline, Mode=OneWay}"
                    Message="You can still open the files you used recently. Changes are saved and sync when you're back online."
                    Severity="Warning" />
                <Grid
                    Margin="{StaticResource LeonardoSpaceXLHorizontalThickness}"
                    ColumnSpacing="{StaticResource LeonardoSpaceM}"
                    RowSpacing="{StaticResource LeonardoSpaceS}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource GalleryDateColumnWidth}" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource LeonardoBodyTextStyle}" Text="Tender documents hall 2.pdf" />
                        <TextBlock Style="{StaticResource LeonardoMetaTextStyle}" Text="Available offline" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Style="{StaticResource LeonardoBodyTabularTextStyle}" Text="Nov 19, 2026" />
                    <StackPanel Grid.Row="1">
                        <TextBlock Style="{StaticResource LeonardoBodyTextStyle}" Text="Site meeting notes.docx" />
                        <TextBlock Style="{StaticResource LeonardoMetaTextStyle}" Text="Available offline · 1 change waiting to sync" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource LeonardoBodyTabularTextStyle}"
                        Text="Nov 17, 2026" />
                </Grid>
            </StackPanel>

            <TextBlock
                Margin="{StaticResource LeonardoSpaceXLHorizontalThickness}"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource LeonardoMetaTextStyle}"
                Text="{x:Bind Feedback, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
