<?xml version="1.0" encoding="utf-8"?>
<!--
    Resources of the gallery itself. Colors, spacing, radii, font sizes and motion come from Leonardo resources only.
    The sizes below are layout sizes Leonardo does not define (pane and column widths, icon and sample sizes).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Charts use the blue scale: near on light ground, far on dark ground. High contrast uses the window text color. -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GalleryChartBrush" Color="{StaticResource LeonardoPaletteNearColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="GalleryChartBrush" Color="{StaticResource LeonardoPaletteFarColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="GalleryChartBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Small icons, as in File Explorer lists. They hang to the left of the alignment line. -->
    <x:Double x:Key="GalleryIconSize">16</x:Double>
    <x:Double x:Key="GalleryLargeIconSize">32</x:Double>

    <!-- Running text keeps about 60 characters per line. -->
    <x:Double x:Key="GalleryReadingWidth">600</x:Double>
    <x:Double x:Key="GallerySettingsWidth">1000</x:Double>

    <!-- Asymmetric balance: navigation fixed, content flexible, details fixed. -->
    <GridLength x:Key="GalleryTreePaneWidth">200</GridLength>
    <GridLength x:Key="GalleryListPaneWidth">320</GridLength>
    <GridLength x:Key="GalleryDetailsPaneWidth">280</GridLength>

    <!-- Table columns. -->
    <GridLength x:Key="GalleryDateColumnWidth">112</GridLength>
    <GridLength x:Key="GalleryPersonColumnWidth">104</GridLength>
    <GridLength x:Key="GalleryNumberColumnWidth">80</GridLength>
    <GridLength x:Key="GalleryNameColumnMinWidth">200</GridLength>

    <!-- Window widths at which panes appear. Below them, a page shows less instead of clipping. -->
    <x:Double x:Key="GalleryDetailsPaneWindowWidth">1200</x:Double>
    <x:Double x:Key="GalleryTreePaneWindowWidth">760</x:Double>
    <GridLength x:Key="GalleryLabelColumnWidth">120</GridLength>

    <!-- Samples on the foundation pages. -->
    <x:Double x:Key="GallerySwatchSize">40</x:Double>
    <x:Double x:Key="GallerySampleSize">64</x:Double>
    <x:Double x:Key="GalleryWrapSampleWidth">280</x:Double>
    <x:Double x:Key="GalleryChartHeight">120</x:Double>
    <x:Double x:Key="GalleryFigureWidth">200</x:Double>
    <x:Double x:Key="GalleryChartBarWidth">32</x:Double>
    <x:Double x:Key="GalleryGuideLineWidth">1</x:Double>
    <Thickness x:Key="GalleryHairlineThickness">1</Thickness>

    <!--
        List rows follow the density setting: the item template sets its height, so the container only keeps
        the smallest Leonardo row height as its minimum. Nothing else of the Fluent item style changes.
    -->
    <Style x:Key="GalleryListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="MinHeight" Value="{StaticResource LeonardoDensityCompact}" />
    </Style>

    <!--
        Table rows: the same padding left and right, so that the column header above the list can use the same
        padding and right-aligned numbers line up with their header.
    -->
    <Style x:Key="GalleryTableItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource GalleryListViewItemStyle}">
        <Setter Property="Padding" Value="{StaticResource LeonardoSpaceMHorizontalThickness}" />
    </Style>

    <!-- Labels of label/value pairs, for example in details panes. -->
    <Style x:Key="GalleryFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource LeonardoMetaTextStyle}" />
</ResourceDictionary>
