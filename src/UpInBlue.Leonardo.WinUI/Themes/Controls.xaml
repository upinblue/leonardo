<?xml version="1.0" encoding="utf-8"?>
<!--
    Elements Leonardo defines that apps place in their own templates. Sizes come from the tokens: the status dot is
    LeonardoSizeStatusDot and icons are LeonardoSizeIcon, both in Tokens.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The Arrive marker: a short accent bar at the start of a row, as high as an icon (size.icon) and as wide as the
        row's leading padding (space.xs). Its opacity is 0 at rest; Arrive.Run fades it in, holds it for
        motion.arrive.hold and fades it out. The dot shape stays reserved for the StatusDot. Arrive announces the new item
        itself, so the marker is hidden from UI Automation.

        <Border x:Name="ArriveMarker" Style="{StaticResource LeonardoArriveMarkerStyle}" />
    -->
    <Style x:Key="LeonardoArriveMarkerStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource LeonardoSpaceXS}" />
        <Setter Property="Height" Value="{StaticResource LeonardoSizeIcon}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="{StaticResource LeonardoRadiusS}" />
        <Setter Property="Background" Value="{ThemeResource LeonardoAccentBrush}" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>
</ResourceDictionary>
