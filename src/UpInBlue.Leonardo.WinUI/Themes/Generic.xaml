<?xml version="1.0" encoding="utf-8"?>
<!--
    Default styles of the three controls Leonardo adds: PlaceHeader, SummaryLine and StatusDot.
    They need the resources of Leonardo.xaml, which apps merge after XamlControlsResources.
    Colors, spacing and text styles come from Leonardo and Fluent resources at runtime (ThemeResource), so they follow
    the theme and contrast themes. Fluent controls inside (ToggleButton) keep their own style.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UpInBlue.Leonardo.WinUI.Controls">

    <Style TargetType="controls:StatusDot">
        <!-- LeonardoSizeStatusDot (size.statusDot) comes from the tokens, merged by Leonardo.xaml. The shapes are drawn on a 12 × 12 grid and scale with it. -->
        <Setter Property="Width" Value="{ThemeResource LeonardoSizeStatusDot}" />
        <Setter Property="Height" Value="{ThemeResource LeonardoSizeStatusDot}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatusDot">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="KindStates">
                                <VisualState x:Name="New" />
                                <VisualState x:Name="CheckedOut">
                                    <VisualState.Setters>
                                        <Setter Target="NewShape.Visibility" Value="Collapsed" />
                                        <Setter Target="CheckedOutShape.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Conflict">
                                    <VisualState.Setters>
                                        <Setter Target="NewShape.Visibility" Value="Collapsed" />
                                        <Setter Target="ConflictShape.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Viewbox Stretch="Uniform">
                            <Canvas Width="12" Height="12">
                                <!-- New: a filled dot in the accent color, smaller than the others because it is the calmest state. -->
                                <Ellipse
                                    x:Name="NewShape"
                                    Canvas.Left="2"
                                    Canvas.Top="2"
                                    Width="8"
                                    Height="8"
                                    Fill="{ThemeResource LeonardoAccentBrush}" />

                                <!-- Checked out: a ring in the system caution color. -->
                                <Ellipse
                                    x:Name="CheckedOutShape"
                                    Canvas.Left="1"
                                    Canvas.Top="1"
                                    Width="10"
                                    Height="10"
                                    Stroke="{ThemeResource SystemFillColorCautionBrush}"
                                    StrokeThickness="2"
                                    Visibility="Collapsed" />

                                <!-- Conflict: a filled circle with an exclamation mark in the system critical color, like Fluent's critical badge. -->
                                <Grid
                                    x:Name="ConflictShape"
                                    Width="12"
                                    Height="12"
                                    Visibility="Collapsed">
                                    <Ellipse Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <Path Data="M5.25,2.5 L6.75,2.5 L6.75,7 L5.25,7 Z M5.25,8.25 L6.75,8.25 L6.75,9.75 L5.25,9.75 Z" Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Grid>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:SummaryLine">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SummaryLine">
                    <!-- The sentence panel is created in code: it lays out words and phrases like running text. -->
                    <Border
                        x:Name="PART_Host"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:PlaceHeader">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PlaceHeader">
                    <Grid
                        x:Name="PART_Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="PART_Meta"
                            Style="{ThemeResource LeonardoMetaTextStyle}"
                            Text="{TemplateBinding Meta}" />

                        <!-- Both titles share one cell, so the header knows how much height it gives up when it shrinks. -->
                        <Grid Grid.Row="1">
                            <TextBlock
                                x:Name="PART_Title"
                                AutomationProperties.HeadingLevel="Level1"
                                Style="{ThemeResource LeonardoPlaceNameTextStyle}"
                                Text="{TemplateBinding Title}" />
                            <TextBlock
                                x:Name="PART_CompactTitle"
                                VerticalAlignment="Top"
                                AutomationProperties.AccessibilityView="Raw"
                                IsHitTestVisible="False"
                                Opacity="0"
                                Style="{ThemeResource LeonardoSectionTextStyle}"
                                Text="{TemplateBinding Title}" />
                        </Grid>

                        <ContentPresenter
                            x:Name="PART_Content"
                            Grid.Row="2"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
